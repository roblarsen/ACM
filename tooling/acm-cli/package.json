{
  "name": "acm-cli",
  "version": "1.1.0",
  "description": "CLI validator and parser for the Assumptions & Constraints Manifest (ACM) specification",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "acm-cli": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/cli.js",
    "prepare": "npm run build",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test dist/test/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/roblarsen/ACM.git",
    "directory": "tooling/acm-cli"
  },
  "homepage": "https://github.com/roblarsen/ACM#readme",
  "bugs": {
    "url": "https://github.com/roblarsen/ACM/issues"
  },
  "keywords": [
    "acm",
    "engineering-governance",
    "design-by-contract",
    "code-review",
    "ai-governance",
    "distributed-systems"
  ],
  "author": "Rob Larsen",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "yaml": "^2.4.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.3.3"
  },
  "type": "module"
}
